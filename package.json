{
  "name": "metascope",
  "version": "0.1.0",
  "description": "Interactive terminal file viewer with syntax highlighting (Metarhia)",
  "license": "MIT",
  "keywords": [
    "metarhia",
    "cli",
    "viewer",
    "syntax",
    "markdown",
    "terminal"
  ],
  "bin": {
    "metascope": "./bin/metascope.js"
  },
  "main": "lib/app.js",
  "files": [
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "concolor": "^1.1.4",
    "metautil": "^5.5.2"
  },
  "scripts": {
    "start": "node bin/metascope.js",
    "install:local": "node scripts/install-local.js",
    "uninstall:local": "node scripts/uninstall-local.js",
    "test": "npm run lint && npm run types && node --test \"test/*.js\"",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check \"**/*.js\" \"**/*.json\" \"**/*.md\" \"**/*.ts\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\" \"**/*.ts\""
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-metarhia": "^9.1.9",
    "metaskills": "^1.0.4",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3"
  }
}
